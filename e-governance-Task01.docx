					<div id="m_msgTextAreaRevamp" tabindex="-1" aria-readonly="true" role="textbox" style="outline: none; overflow-y: auto; direction: ltr; display: none;"><div></div></div>
					<div id="m_msgSessionIdAreaRevamp" style="overflow-y: auto; direction: ltr; display: none;"><div></div></div>
